<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{collectionName}} - Flashcards</title>
    <style>
        {{{stylesheet}}}
    </style>
</head>
<body>
    <a href="/flashcards/collections" class="back-link">← Back to Collections</a>
    <h1 class="collection-title">{{collectionName}}</h1>

    <table class="flashcards-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Front</th>
                <th>Back</th>
            </tr>
        </thead>
        <tbody>
            {{#flashcards}}
            <tr>
                <td>{{index}}</td>
                <td>{{{front}}}</td>
                <td>{{{back}}}</td>
            </tr>
            {{/flashcards}}
        </tbody>
    </table>

    <div class="action-buttons">
        <button class="delete-btn" onclick="deleteCollection()">Delete Collection</button>
    </div>

    <script>
        function deleteCollection() {
            fetch(window.location.pathname, {
                method: 'DELETE',
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                }
            })
        }
    </script>
</body>
</html>
